            <datasource caption='Worklist' name='Worklist' />
          </datasources>
          <datasource-dependencies datasource='Worklist'>
            <column datatype='string' name='[Patient]' role='dimension' type='nominal' />
            <column-instance column='[Patient]' derivation='None' name='[none:Patient:nk]' pivot='key' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[Score]' role='measure' type='quantitative' />
            <column-instance column='[Score]' derivation='Sum' name='[sum:Score:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[Priority]' role='dimension' type='nominal' />
            <column-instance column='[Priority]' derivation='None' name='[none:Priority:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[LeadCondition]' role='dimension' type='nominal' />
            <column-instance column='[LeadCondition]' derivation='None' name='[none:LeadCondition:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <sort class='computed' column='[Worklist].[none:Patient:nk]' direction='DESC' using='[Worklist].[sum:Score:qk]' />
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' field='[Worklist].[sum:Score:qk]' scope='cols' value='Priority score' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[Worklist].[none:Priority:nk]' />
              <text column='[Worklist].[sum:Score:qk]' />
              <tooltip column='[Worklist].[none:LeadCondition:nk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[Worklist].[none:Patient:nk]</rows>
        <cols>[Worklist].[sum:Score:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Care gap closure'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='18'>Care-gap closure: who to call first</run>
          </formatted-text>
        </title>
      </layout-options>
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' />
      <zones>
        <zone h='100000' id='2' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='6000' id='3' type='title' w='100000' x='0' y='0' />
          <zone h='7000' id='4' type='text' w='100000' x='0' y='6000'>
            <formatted-text>
              <run fontsize='11'>A care gap is a diagnosis with no medication and no procedure in the next 90 days. 2,469 gaps. 908 patients (79.0% of patients with an eligible condition). Baseline gap rate 30.5%. No outreach has run. This is the yardstick, not a result.</run>
            </formatted-text>
          </zone>
          <zone h='16000' id='5' name='Headline' show-title='true' w='100000' x='0' y='13000' />
          <zone h='28000' id='6' name='Gaps by condition' show-title='true' w='50000' x='0' y='29000' />
          <zone h='28000' id='7' name='Call first' show-title='true' w='50000' x='50000' y='29000' />
          <zone h='22000' id='8' name='Where to expand' show-title='true' w='50000' x='0' y='57000' />
          <zone h='22000' id='9' name='Where it is already lower' show-title='true' w='50000' x='50000' y='57000' />
          <zone h='21000' id='10' name='Monthly trend' show-title='true' w='100000' x='0' y='79000' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
